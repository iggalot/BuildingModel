<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>BuildingModel.Sketch</RootNamespace>
    <AssemblyName>BuildingModel.Sketch</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BuildingModel.Core\BuildingModel.Core.csproj" />
    <!-- the folder picker for project folders (part of the .NET Framework) -->
    <Reference Include="System.Windows.Forms" />
    <!-- PDF plans: the PDF renderer built into Windows 10/11 (Windows.Data.Pdf). These metadata files are part of
         every Windows 10/11 machine (System32\WinMetadata) and of the .NET Framework; nothing is downloaded or copied with the app. -->
    <Reference Include="Windows.Foundation">
      <HintPath>$(WINDIR)\System32\WinMetadata\Windows.Foundation.winmd</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Windows.Data">
      <HintPath>$(WINDIR)\System32\WinMetadata\Windows.Data.winmd</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Windows.Storage">
      <HintPath>$(WINDIR)\System32\WinMetadata\Windows.Storage.winmd</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Runtime.WindowsRuntime">
      <HintPath>$(WINDIR)\Microsoft.NET\Framework\v4.0.30319\System.Runtime.WindowsRuntime.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
